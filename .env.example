# App
NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose dùng các biến POSTGRES_* để khởi tạo container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fa26se095
POSTGRES_PASSWORD=fa26se095_dev
POSTGRES_DB=fa26se095

# MongoDB (MONGO_INITDB_* để khởi tạo container, MONGO_URI để app kết nối)
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=fa26se095
MONGO_INITDB_ROOT_PASSWORD=fa26se095_dev
MONGO_URI=mongodb://fa26se095:fa26se095_dev@localhost:27017/fa26se095?authSource=admin

# Auth (JWT_SECRET tối thiểu 32 ký tự)
JWT_SECRET=T9vE4xK2wL8pZ1mQ7jN5bC0rY6hF3sA9gD4fV2zX8cM1nJ7bK5vH0qW3xR9tP6mQ
JWT_EXPIRES_IN=1d

# Seed (npm run seed): tài khoản Admin đầu tiên, mật khẩu tối thiểu 8 ký tự
SEED_ADMIN_EMAIL=admin@fa26se095.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# Frontend: gốc URL dùng tạo link trong email mời kích hoạt
FRONTEND_URL=http://localhost:3001

# Mail: MAIL_DRIVER=log (mặc định, chỉ in email ra log) | smtp (gửi thật, bắt buộc đủ các biến MAIL_* bên dưới)
# Gmail: smtp.gmail.com, cổng 465, MAIL_SECURE=true, MAIL_PASSWORD là App Password (không phải mật khẩu đăng nhập)
# Thử cấu hình: npm run mail:test -- <email>
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="FA26SE095 <your-account@gmail.com>"

# OTP (kích hoạt tài khoản, đặt lại mật khẩu) – không bắt buộc, giá trị dưới là mặc định
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# OTP trong email mời Staff/Designer/Supplier (Admin tạo tài khoản) – tính bằng giờ, khác OTP đăng ký ở trên
INVITE_OTP_TTL_HOURS=72

# Rate limit các route auth công khai (login, register, resend-otp, verify-email), theo IP + route – mặc định như dưới
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# Swagger UI tại /docs (JSON: /docs-json) cho FE test API – đặt false để tắt
SWAGGER_ENABLED=true
